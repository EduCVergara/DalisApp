FROM alpine:3.20

ARG PB_VERSION=0.36.9

RUN apk add --no-cache ca-certificates curl unzip

WORKDIR /pb

RUN curl -fsSL "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip" -o /tmp/pocketbase.zip \
  && unzip /tmp/pocketbase.zip -d /pb \
  && rm /tmp/pocketbase.zip \
  && chmod +x /pb/pocketbase

COPY scripts/start-pocketbase.sh /pb/start-pocketbase.sh
RUN chmod +x /pb/start-pocketbase.sh

EXPOSE 8080

CMD ["/pb/start-pocketbase.sh"]
